{
    "name": "isometriks/spam-bundle",
    "description": "Provides spam protection for Symfony forms",
    "keywords": ["spam", "symfony", "form", "bundle"],
    "require": {
        "php": ">=7.4",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/form": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/options-resolver": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation-contracts": "1.0 || ^2.0 || ^3.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.4",
        "phpunit/phpunit": "^9.1.1 || ^9.5",
        "symfony/phpunit-bridge": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "authors": [
        {
            "name": "Craig Blanchette",
            "email": "craig.blanchette@gmail.com",
            "homepage": "http://isometriks.com"
        },
        {
            "name": "Patrik Pacin",
            "email": "github@exploit.cz",
            "homepage": "https://exploit.cz"
        }
    ],
    "autoload": {
        "psr-4": {
            "Isometriks\\SpamBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Isometriks\\SpamBundle\\Tests\\": "tests/"
        }
    }
}
